# Supabase - new zaostock project
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Iron-session secret (generate with: openssl rand -base64 32)
SESSION_SECRET=

# Public app URL
NEXT_PUBLIC_APP_URL=https://zaostock.com

# Vercel Cron auth (generate with: openssl rand -base64 32) - protects
# /api/cron/deactivate-inactive. Vercel sends this automatically as
# `Authorization: Bearer $CRON_SECRET` for scheduled invocations once the
# env var is set on the project.
CRON_SECRET=

# Privy (mobile app auth) - App ID is public and defaults in code, but the
# JWT Verification Key is required to verify identity tokens server-side.
# Find it in the Privy dashboard under the app's Settings - it's a narrower
# credential than the App Secret (can only verify tokens, no wallet/API
# access), so that's the one this app actually needs.
PRIVY_APP_ID=cmrlw537c029y0cjp8xurotsp
PRIVY_VERIFICATION_KEY=
